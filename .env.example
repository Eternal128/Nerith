# Demo mode — set to true to bypass real auth and use fixture data
DEMO_MODE=true

# Supabase — required for real auth/db; not needed in demo mode
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM keys — optional; mock LLM used when absent
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Replay stream speed (seconds between events)
REPLAY_INTERVAL_SECONDS=10
